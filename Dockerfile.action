FROM ghcr.io/astral-sh/uv:0.12.9@sha256:8b940d3a9d65bed080436972241af2e21c84b5e8c9193f7014ed71479ee795ff AS uv

FROM python:3.11-slim@sha256:9c900dea9e8fb7e16277c179b555cc72d29a352dbc33cff48ad5a0412fd5bfc7 AS builder

WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src

RUN uv sync --frozen --no-dev

FROM python:3.11-slim@sha256:9c900dea9e8fb7e16277c179b555cc72d29a352dbc33cff48ad5a0412fd5bfc7

WORKDIR /app

COPY --from=builder /app/.venv ./.venv
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY action-entrypoint.sh /usr/local/bin/action-entrypoint

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip setuptools wheel \
    && chmod 755 /usr/local/bin/action-entrypoint \
    && useradd --create-home --uid 10001 hound

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

LABEL org.opencontainers.image.title="Hound GitHub Action" \
      org.opencontainers.image.licenses="MIT"

# The entrypoint restores workspace ownership after writing action artifacts.
ENTRYPOINT ["/usr/local/bin/action-entrypoint"]
