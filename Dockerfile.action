FROM ghcr.io/astral-sh/uv:0.10.8@sha256:88234bc9e09c2b2f6d176a3daf411419eb0370d450a08129257410de9cfafd2a AS uv

FROM python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6 AS builder

WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src

RUN uv sync --frozen --no-dev

FROM python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6

WORKDIR /app

COPY --from=builder /app/.venv ./.venv
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY action-entrypoint.sh /usr/local/bin/action-entrypoint

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip setuptools wheel \
    && chmod 755 /usr/local/bin/action-entrypoint \
    && useradd --create-home --uid 10001 hound

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

LABEL org.opencontainers.image.title="Hound GitHub Action" \
      org.opencontainers.image.licenses="MIT"

# The entrypoint restores workspace ownership after writing action artifacts.
ENTRYPOINT ["/usr/local/bin/action-entrypoint"]
