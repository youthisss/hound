# hound_agent LLM configuration
#
# Pick ONE provider. Every provider is OpenAI-compatible and can also be
# configured with the generic variables at the bottom.

# --- Generic OpenAI-compatible (works with any provider) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# --- Named providers (TH_API_PROVIDER selects which one to use) ---
# TH_API_PROVIDER=openai          # or: anthropic, gemini, groq, ollama, deepseek, azure, 9router, custom
# TH_API_KEY=
# TH_BASE_URL=
# TH_MODEL=

# --- 9Router (local OpenAI-compatible gateway) ---
# TH_API_PROVIDER=9router
# NINE_ROUTER_API_KEY=9router
# NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
# NINE_ROUTER_MODEL=ag/gemini-3.7-flash-low

# --- Anthropic ---
# TH_API_PROVIDER=anthropic
# TH_API_KEY=sk-ant-...
# TH_BASE_URL=https://your-openai-compatible-anthropic-proxy.example/v1
# TH_MODEL=claude-sonnet-4-20250514

# --- Google Gemini ---
# TH_API_PROVIDER=gemini
# TH_API_KEY=AIza...
# TH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# TH_MODEL=gemini-3.7-flash

# --- Groq ---
# TH_API_PROVIDER=groq
# TH_API_KEY=gsk_...
# TH_BASE_URL=https://api.groq.com/openai/v1
# TH_MODEL=llama-3.3-70b-versatile

# --- Ollama (local, no key) ---
# TH_API_PROVIDER=ollama
# TH_BASE_URL=http://localhost:11434/v1
# TH_MODEL=llama3.1

# --- DeepSeek ---
# TH_API_PROVIDER=deepseek
# TH_API_KEY=sk-...
# TH_BASE_URL=https://api.deepseek.com
# TH_MODEL=deepseek-chat

# --- Azure OpenAI ---
# TH_API_PROVIDER=azure
# TH_API_KEY=...
# TH_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# TH_MODEL=<deployment-name>

# --- Custom (any OpenAI-compatible endpoint, e.g. 9Router gateway) ---
# TH_API_PROVIDER=custom
# TH_API_KEY=any
# TH_BASE_URL=http://localhost:20128/v1
# TH_MODEL=gpt-4o-mini

# --- LLM behavior ---
# TH_TEMPERATURE=0.2
# TH_TIMEOUT=120
# TH_MAX_TOKENS=2048
# TH_REQUIRE_LLM=1                # fail instead of using fallback when online RCA fails

# --- Optional: GitHub issue filing ---
# GH_TOKEN=
# GH_REPO=owner/name
# GH_API_BASE=https://api.github.com
